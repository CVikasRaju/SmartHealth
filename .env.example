# ---------------------------------------------------------------------------
# SmartMedic environment
# ---------------------------------------------------------------------------
# Copy to `.env` for local development. `.env` is git-ignored: never commit
# real keys.
#
# The same four Supabase values are needed in two places:
#   * locally, in `.env`
#   * on Vercel, in Project → Settings → Environment Variables
#
# The service role key is server-only. It must never be given a VITE_ prefix,
# because everything prefixed with VITE_ is inlined into the browser bundle.
# ---------------------------------------------------------------------------

# --- Supabase, used by the API (server side) -------------------------------
# Project Settings → API → Project URL
SUPABASE_URL=
# Project Settings → API → Project API keys → anon / public
SUPABASE_ANON_KEY=
# Project Settings → API → Project API keys → service_role (SECRET)
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase, used by the browser (build time) ----------------------------
# The same URL and anon key as above. These are public by design; row level
# security and the API are what protect the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AI Model Providers (Optional) ----------------------------------------
# Provide an OpenRouter key (sk-or-v1-...) or Google Gemini key (AIzaSy...)
# for live clinical report reasoning and conversational patient assistant.
VITE_OPENROUTER_API_KEY=
VITE_GEMINI_API_KEY=

# Port for `npm run dev:api` (the Vite proxy points here).
PORT=8787
